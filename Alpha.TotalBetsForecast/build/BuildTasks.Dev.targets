<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
         DefaultTargets="MyTargets"
         InitialTargets="MyTargets">
  <Target Name="MyTargets">
	<Exec Command="Nuget\NuGet restore ..\Alpha.TotalBetsForecast.sln"/>
	<MSBuild Projects="..\Alpha.TotalBetsForecast.sln" 
	Properties="RunNunitTests=true;TreatWarningsAsErrors=false;RunCodeAnalysis=true;StyleCopEnabled=true" />
	
  </Target>
  
</Project>
