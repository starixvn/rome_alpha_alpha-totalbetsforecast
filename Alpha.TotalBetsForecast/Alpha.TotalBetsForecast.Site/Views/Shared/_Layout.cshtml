<!DOCTYPE html>
<html class="ifr-result">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Bets & Forecast Soccer</title>    
    <link href="/assets/bundles/site-totalbetsforecast/default.css" rel="stylesheet" />
    
    @RenderSection("ComponentStyles", false)

    @RenderSection("Styles", false)

</head>
<body>
    <div class="page-main">
        @RenderBody()
    </div>

    @Html.Hidden("RootURL", HttpContext.Current.Response.ApplyAppPathModifier("~/"))
     
    <script type="text/javascript" src="/assets/bundles/site-totalbetsforecast/default.js"></script>

    @RenderSection("Scripts", false)

    <!-- Piwik -->
    <script type="text/javascript" async>
        var _pkUrl = '//pw.detecas.com/piwik.php',
            _pkScript = '//pw.detecas.com/piwik.js',
            _pkSiteId = '@Sunplus.Agent.Model.BL.Definitions.AppSettings.PiwikSiteId';

    </script>
    <script src="~/Scripts/piwikLoader.js"></script>
    <noscript>
        <p>
            <img src="//pw.detecas.com/piwik.php?idsite=@Sunplus.Agent.Model.BL.Definitions.AppSettings.PiwikSiteId" style="border: 0;" alt="" />
        </p>
    </noscript>
    <!-- End Piwik Code -->
</body>
</html>


