<div class="container-fluid totalandforecast">
    <ul class="breadcrumb">
        <li>Bets & Forecast</li>
        <li>Soccer</li>
    </ul>
    <div class="filter">
        <form class="form-inline" role="form">
            <div class="form-group">
                <label class="">Deadball</label>
                <select id="ddlDeadball">
                    <option>Deadball</option>
                    <option>LiveBall</option>
                </select>
            </div>
            <div class="form-group">
                <label>League</label>
                <select id="ddlLeague">
                    <option>ENGLISH PREMIER LEAGUE</option>
                </select>
            </div>
            <div class="form-group">
                <label>Event</label>
                <select id="ddlEvent">
                    <option>All Event</option>
                </select>
            </div>
            <div class="form-group">
                <input type="button" class="btn btnSubmit" value="Submit"/>
                <a class="btn btnRefresh">48</a>
            </div>
        </form>
    </div>
