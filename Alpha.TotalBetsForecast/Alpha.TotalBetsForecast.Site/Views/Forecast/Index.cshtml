@model IndexViewModel

@section Styles 
{
    <link href='/contents/css/Fonts/Iconalpha/Iconalpha.css' rel='stylesheet' type='text/css'>
    <link href="/contents/css/sass/component.min.css" rel="stylesheet" />
    <link href="/contents/components/select2/css/select2.min.css" rel="stylesheet" />
    <link href="/contents/components/mutipleselect/css/bootstrap-multiselect.css" rel="stylesheet" />

    @Styles.Render(BundleConfig.IndexForecastStyleBundleUrl)
}

<div class="container-fluid totalandforecast">
    <ul class="breadcrumb">
        <li>@Sunplus.Agent.Model.RemotingRef.CacheRefFactory.CacheRef.GetSportName(1)</li>
    </ul>
    <div class="filter">
        <form class="form-inline" role="form">

            <div class="form-group">
                <label class="">@Resources.Deadball</label>
                @Html.DropDownListFor(model => model.IsLive, Model.LiveValues, new { @class = "form-control", @id = "ddlDeadBall", @onchange = "this.form.submit()" })
            </div>

            <div class="form-group">
                <label>@Resources.League</label>
                @Html.DropDownListFor(model => model.LeagueId, Model.Leagues)
            </div>

            <div class="form-group">
                <label>@Resources.Event</label>
                <select id="ddlMatch" multiple="multiple" data-init-lable="@Resources.SelectAMatch" data-selected-event-text="@Resources.SelectedEvents" style="display:none;">
                </select>
            </div>
            <div class="form-group">
                <input type="button" class="btn btnSubmit" id="btnSubmit" value="@Resources.Submit"/>
                <a class="btn btnRefresh" id="btnRefresh"></a>
            </div>
        </form>
        <span class="help" data-toggle="modal" data-target="#helpModal" title="Help"></span>
    </div>
    <div class="content" style="display:none;">
        <span class="text-status">@(Model.IsLive ? Resources.MatchOfferLive : Resources.Deadball )</span>
        <table class="tblRpt col-sm-12" id="mainContent">
            <thead>
                <tr class="RptHeader">
                    <th class="text-center">@Resources.Time</th>
                    <th class="text-center">@Resources.Event</th>
                    <th class="text-center">@Resources.BetType</th>
                    <th class="text-center">@Resources.BetCount</th>
                    <th class="text-center">@Resources.Turnover</th>
                    <th class="text-center" colspan="3">@Resources.ForecastWinLoss</th>
                    <th class="text-center">@Resources.ForecastTotal</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
<!-- Button trigger modal -->


<!-- Modal -->
<div class="modal fade" id="helpModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">@Resources.BetsAndForecastGuidelines</h4>
            </div>
            <div class="modal-body">
                <div class="popup">
                    <div class="modal-body note-content">
                        <ul class="level1">
                            <li><span class="bold">Time:</span> kick-off time (in Deadball events) or Live score (in Live events).</li>
                            <li><span class="bold">Event:</span> names of <span class="bold positive">Home</span>/<span class="bold">Away</span> teams.</li>
                            <li><span class="bold">Bet Type:</span> all available bet types and selected choices for that event.</li>
                            <li>
                                <span class="bold">Bet Count:</span> number of bet tickets.
                                <ul class="level2">
                                    <li><span class="bold">Handicap:</span> number of tickets bet on Home/Away team.</li>
                                    <li><span class="bold">Over Under:</span> number of tickets bet on Over/Under choice.</li>
                                    <li><span class="bold">1X2:</span> number of tickets bet on Home team/Draw/Away team.</li>
                                </ul>
                            </li>
                            <li>
                                <span class="bold">Turnover</span>
                                <ul class="level2">
                                    <li><span class="bold">Handicap:</span> amount of stakes bet on Home/Away team.</li>
                                    <li><span class="bold">Over Under:</span> amount of stakes bet on Over/Under choice.</li>
                                    <li><span class="bold">1X2:</span> amount of stakes bet on Home team/Draw/Away team.</li>
                                </ul>
                            </li>
                            <li>
                                <span class="bold">Forecast Win/Loss:</span> predicts win loss amount on running tickets of the event (the <span class="bold">Black Negative Number</span> indicates the amount you may win and members may lose, whereas, the <span class="bold positive">Red Positive Number</span> indicates the amount you may lose and members may win).
                                <ul class="level2">
                                    <li>
                                        <span class="bold">Hadicap</span>
                                        <ul class="level3">
                                            <li><span class="bold">Deadball:</span> predicts win loss amount of three total goals nearest zero, with different forecast figures.</li>
                                            <li><span class="bold">Live:</span> predicts win loss amount of three cases (current score, one more goal scored by Home team, and one more goal scored by Away team).</li>
                                        </ul>
                                    </li>
                                    <li>
                                        <span class="bold">Over Under</span>
                                        <ul class="level3">
                                            <li><span class="bold">Deadball:</span> predicts win loss amount of three total goals nearest zero, with different forecast figures.</li>
                                            <li><span class="bold">Live:</span> predicts win loss amount of 3 cases (current score, current score + 1, and current score + 2)</li>
                                        </ul>
                                    </li>
                                    <li><span class="bold">1X2:</span>predicts win loss amount of three cases: Home wins, Draw and Away wins.</li>
                                </ul>
                            </li>
                            <li>
                                <span class="bold">Forecast Total:</span> summarizes total Forecast Win Loss amount on running tickets of the event.
                                <ul class="level2">
                                    <li><span class="bold">Deadball:</span> the total Forecast Win Loss amount on the event before kick-off.</li>
                                    <li><span class="bold">Live:</span> the total Forecast Win Loss amount on the event with the current live score.</li>
                                </ul>
                            </li>
                        </ul>
                        <div class="note">Note: All figures of Turnover and Forecast above are after deducting Position Taking.</div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>


@section Scripts
{
    <script type="text/javascript" src="/contents/components/select2/js/select2.min.js"></script>
    <script type="text/javascript" src="/contents/components/countdown/jquery.countdown.min.js"></script>
    <script type="text/javascript" src="/contents/components/mutipleselect/js/bootstrap-multiselect.min.js"></script>

    @Scripts.Render(BundleConfig.IndexForecastJavascriptBundleUrl)
}
