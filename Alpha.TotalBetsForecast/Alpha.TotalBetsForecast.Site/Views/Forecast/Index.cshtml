@section Styles 
{
    <link href="/contents/css/sass/component.min.css" rel="stylesheet" />
    <link href="~/Content/totalbets-forecast.css" rel="stylesheet"/>
}
<div class="container-fluid totalandforecast">
    <ul class="breadcrumb">
        <li>Bets & Forecast</li>
        <li>@Sunplus.Agent.Model.RemotingRef.CacheRefFactory.CacheRef.GetSportName(1)</li>
    </ul>
    <div class="filter">
        <form class="form-inline" role="form">

            <div class="form-group">
                <label class="">@Resources.Deadball</label>
                <select id="ddlDeadball">
                    <option value="0">@Resources.Deadball</option>
                    <option value="1">@Resources.Live</option>
                </select>
            </div>

            <div class="form-group">
                <label>@Resources.League</label>
                <select id="ddlLeague">
                </select>
            </div>

            <div class="form-group">
                <label>@Resources.Event</label>
                <select id="ddlEvent">
                </select>
            </div>
            <div class="form-group">
                <input type="button" class="btn btnSubmit" value="@Resources.Submit"/>
                <a class="btn btnRefresh">48</a>
            </div>
        </form>
    </div>
    <div class="content ">
        <table class="tblRpt col-sm-12" id="dataTotalBet">
            <thead>
                <tr class="RptHeader">
                    <th class="text-center">@Resources.Time</th>
                    <th class="text-center">@Resources.Event</th>
                    <th class="text-center">@Resources.BetType</th>
                    <th class="text-center">@Resources.BetCount</th>
                    <th class="text-center">@Resources.Turnover</th>
                    <th class="text-center" colspan="3">@Resources.ForecastWinLoss</th>
                    <th class="text-center">@Resources.ForecastTotal</th>
                </tr>
            </thead>
            <tbody>
                @Html.Action("MatchForecast",
                new
                {
                    MatchId = 16470785, //14649182,16470785
                    IsLive = true,
                    LiveHomeScore = 1,
                    LiveAwayScore = 0
                })
            </tbody>
        </table>
    </div>
</div>
