@model IndexViewModel

@section Styles 
{
    <link href='/contents/css/Fonts/Iconalpha/Iconalpha.min.css' rel='stylesheet' type='text/css'>
    <link href="/contents/components/mutipleselect/css/bootstrap-multiselect.min.css" rel="stylesheet" />
    <link href="/contents/css/sass/component.min.css" rel="stylesheet" />

    @Styles.Render(BundleConfig.IndexForecastStyleBundleUrl)
}

<div id="browser-warning" class="note-browser" style="display:none;">
    <span class="icon-alert"></span>
    <div class="textnote-box">
        <span class="text-note">@Resources.BrowserIsOutOfDate</span>
        <a href="http://windows.microsoft.com/en-us/internet-explorer/download-ie" target="_blank">@Resources.ClickToUpdateBrowser</a>
    </div>
    <span class="icon-closed" id="close-warning"></span>
</div>

<div class="container-fluid totalandforecast">
    <ul class="breadcrumb">
        <li>@Resources.BetsAndForecast</li>
        <li>
            @Sunplus.Agent.Model.RemotingRef.CacheRefFactory.CacheRef.GetSportName(1) 
            <span class="help" data-toggle="modal" data-target="#helpModal" title="Help"></span>
        </li>

    </ul>
    <div class="filter">
        <form class="" role="form">
            <div class="form-group">
                @Html.DropDownListFor(model => model.IsLive, Model.LiveValues, new { @class = "", @id = "ddlDeadBall"})
            </div>

            <div class="form-group">
                <label>@Resources.League</label>
                <select id="ddlLeague" style="display:none;"></select>
            </div>

            <div class="form-group">
                <label>@Resources.Event</label>
                <select id="ddlMatch" multiple="multiple" 
                        data-init-lable="@Resources.SelectAMatch" 
                        data-selected-event-text="@Resources.SelectedEvents"
                        data-select-at-least="@Resources.SelectAtLeastOneMatch"
                        data-select-all-text="@Resources.AllEvents"
                        style="display:none;">
                </select>
            </div>
            <div class="form-group">
                <input type="button" class="btn btnSubmit" id="btnSubmit" value="@Resources.Submit"/>
                <span class="dropdown">
                    <button class="btn btn-default btn-countdown dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <span class="icon-refresh"></span>
                        <span id="ddlRefresh">30</span>
                        <span class="caret"></span>
                    </button>
                    <ul class="dropdown-menu" id="refresh-value" aria-labelledby="dropdownMenu2">
                        <li><a href="javascript:void(0);" data-refresh-value="30">30</a></li>
                        <li><a href="javascript:void(0);" data-refresh-value="45">45</a></li>
                        <li><a href="javascript:void(0);" data-refresh-value="60">60</a></li>
                    </ul>
                </span>
                <span class="block-icon-small" id="blockIconSmall" style="display:none;"></span>
            </div>
        </form>
    </div>
    <div class="content" style="display:none;">
        <span id="text-status" class="text-status" 
              data-offer-live="@Resources.MatchOfferLive"
              data-dead-ball="@Resources.Deadball">@Resources.MatchOfferLive</span>
        <table class="tblRpt col-sm-12" id="mainContent"
               data-no-data-text="@Resources.NoData"
               data-offer-live="@Resources.MatchOfferLive"
               data-goal="@Resources.Goals"
               data-disable-highlight="@AppConfig.DisableHighlightChange">
            <thead>
                <tr class="RptHeader">
                    <th class="text-center">@Resources.Time</th>
                    <th class="text-center">@Resources.Event</th>
                    <th class="text-center">@Resources.BetType</th>
                    <th class="text-center">@Resources.BetCount</th>
                    <th class="text-center">@Resources.Turnover</th>
                    <th class="text-center" colspan="3">@Resources.ForecastWinLoss</th>
                    <th class="text-center">@Resources.ForecastTotal</th>
                </tr>
            </thead>
        </table>
        
    </div>
</div>
<!-- Button trigger modal -->


<!-- Modal -->
<div class="modal fade" id="helpModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">@Resources.BetsAndForecastGuidelines</h4>
            </div>
            <div class="modal-body">

                @Html.Action("Index", "Introduction")

            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script type="text/javascript" src="/contents/libs/underscore/underscore-min.js"></script>
    <script type="text/javascript" src="/contents/libs/numeral/numeral.min.js"></script>
    <script type="text/javascript" src="/contents/components/coloranimation/jquery.animate-colors-min.js"></script>
    <script type="text/javascript" src="/contents/components/highlight/jquery.pulse.min.js"></script>
    <script type="text/javascript" src="/contents/components/countdown/jquery.countdown.min.js"></script>
    <script type="text/javascript" src="/contents/components/mutipleselect/js/bootstrap-multiselect.min.js"></script>
    <script type="text/javascript" src="/contents/libs/jquery/jquery.cookie.min.js"></script>

    <!--[if lt IE 9]>
    <script type="text/javascript" src="/contents/components/countdown/jquery.countdown.ie8.min.js"></script>
    <script type="text/javascript" src="/contents/components/mutipleselect/js/bootstrap-multiselect.ie8.min.js"></script>
    <![endif]-->

    @Scripts.Render(BundleConfig.IndexForecastJavascriptBundleUrl)
}
