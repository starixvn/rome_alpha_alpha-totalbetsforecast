@model MatchForecastViewModel

@{
    Layout = null;
    var matchHasAnyBetType = Model.BetTypeForecasts.Any();
    if (!matchHasAnyBetType)
    {
        return;
    }

    var matchRowSpan = Model.BetTypeForecasts.Sum(betTypeForecast =>
    {
        return 1 
        + betTypeForecast.BetChoices.Count() 
        + (betTypeForecast.BetChoices.First().WinLossColumnNames.Any() ? 1 : 0);
    });

    var totalBetTypes = Model.BetTypeForecasts.Count();
    var firstBetType = Model.BetTypeForecasts.First();
}

@helper RenderWinLossColumnName(BetChoiceForecast betChoiceForecast)
{
    if (betChoiceForecast.WinLossColumnNames.Any())
    {
        <td class="bet-type" colspan="4"></td>

        foreach (var winlossName in betChoiceForecast.WinLossColumnNames)
        {
            <td class="win-loss-name">@winlossName</td>
        }
    }
}

@helper RenderBetTypeForecast(BetTypeForecast betTypeForecast)
{
    var totalBetChoice = betTypeForecast.BetChoices.Count();

    <tr>
        <td class="bet-type" rowspan="@(totalBetChoice)">
            @betTypeForecast.BetTypeName
        </td>

        @RenderBetChoiceForecast(betTypeForecast.BetChoices.First(), betTypeForecast.IsOneXTwoBetType)
    </tr>
    <tr>
        @for (int i = 1; i < totalBetChoice; i++)
        {
            @RenderBetChoiceForecast(betTypeForecast.BetChoices.ElementAt(i), betTypeForecast.IsOneXTwoBetType)
        }
    </tr>
}

@helper RenderBetChoiceForecast(BetChoiceForecast betChoiceForecast, bool isOneXTwoBetType)
{
    <td class="handicap-value">
        @betChoiceForecast.HandicapValue
    </td>
    <td class="bet-count">@(Formater.DecFormat(betChoiceForecast.BetCount, 0))</td>
    <td class="turn-over">@(Formater.DecFormat(betChoiceForecast.Turnover, 2))</td>

    foreach (var winloss in betChoiceForecast.WinLossValues)
    {
        <td class="win-loss" @(isOneXTwoBetType ? "colspan=3" : string.Empty)>
            @FormatWinLossNumber(winloss)
        </td>
    }
}

@helper FormatWinLossNumber(decimal winloss)
{
    if (winloss > 0)
    {
        <span class="member-positive-winloss">@(Formater.DecFormat(winloss, 2))</span>
    }
    else
    {
        <span class="member-negative-winloss">@(Formater.DecFormat(winloss, 2))</span>
    }
}

@if (matchHasAnyBetType)
{
    <tr class="league-row">
        <td colspan="10">@Model.LeagueName</td>
    </tr>

    <tr class="match-row">
        <td rowspan="@matchRowSpan">@Model.KickOffTime</td>
        <td rowspan="@matchRowSpan">
            <span class="home-team">@Model.HomeName</span> -
            <span class="away-team">@Model.AwayName</span>
        </td>
        
        @RenderWinLossColumnName(Model.BetTypeForecasts.First().BetChoices.First())

        <td rowspan="@matchRowSpan" class="forecast-total">@(Formater.DecFormat(Model.ForecastTotal, 2))</td>
    </tr>

    @RenderBetTypeForecast(Model.BetTypeForecasts.First())

    for (int i = 1; i < totalBetTypes; i++)
    {
        var currentBetTypeForecast = Model.BetTypeForecasts.ElementAt(i);

        var firstBetChoice = currentBetTypeForecast.BetChoices.First();
        if (firstBetChoice.WinLossColumnNames.Any())
        {
            <tr>
                @RenderWinLossColumnName(firstBetChoice)
            </tr>
        }

        @RenderBetTypeForecast(currentBetTypeForecast)

    }
}
else
{
    <tr class="no-info">
        <td colspan="9">There is no data!</td>
    </tr>
}

