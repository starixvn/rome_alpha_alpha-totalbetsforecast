@model MatchForecastViewModel

@{
    Layout = null;

    var matchRowSpan = 0;
    var totalBetTypes = 0;
    var firstBetType = new BetTypeForecast();
    var matchHasAnyBetType = Model.BetTypeForecasts.Any();

    if (matchHasAnyBetType)
    {
        matchRowSpan = Model.BetTypeForecasts.Sum(betTypeForecast =>
        {
            return betTypeForecast.BetChoices.Count()
            + (betTypeForecast.BetChoices.First().WinLossColumnNames.Any() ? 1 : 0);
        });

        totalBetTypes = Model.BetTypeForecasts.Count();
        firstBetType = Model.BetTypeForecasts.First();
    }
}

@helper RenderWinLossColumnName(BetChoiceForecast betChoiceForecast, bool isOverUnder)
{
    if (betChoiceForecast.WinLossColumnNames.Any())
    {
            <td class="ex-col">&nbsp;</td>
            <td class="ex-col">&nbsp;</td>
            <td class="ex-col">&nbsp;</td>

        foreach (var winlossName in betChoiceForecast.WinLossColumnNames)
        {
                <td class="win-loss-name text-center ex-col head">
                    @(isOverUnder ? $"{winlossName} {Resources.Goals}" : winlossName)
                </td>
        }
    }
}

@helper RenderBetTypeForecast(BetTypeForecast betTypeForecast, bool isEven)
{
    var totalBetChoice = betTypeForecast.BetChoices.Count();

    for (int i = 0; i < totalBetChoice; i++)
    {
        <tr class="@(isEven ? "even" : string.Empty) @(i == totalBetChoice - 1 ? "last-row" : string.Empty)">

            @{
                var betChoice = betTypeForecast.BetChoices.ElementAt(i);

                if (betTypeForecast.IsHandicap)
                {
                    if (i == 0)
                    {
                        <td class="ex-col">
                            <span class="pull-left">@betTypeForecast.BetTypeName</span>
                            <span class="pull-right ex-text">@betChoice.HandicapValue</span>
                        </td>
                    }
                    else
                    {
                        <td class="ex-col">&nbsp;</td>
                    }
                }

                if (betTypeForecast.IsOverUnder)
                {
                    if (i == 0)
                    {
                        <td class="ex-col">
                            <span class="pull-left">@betTypeForecast.BetTypeName</span>
                            <span class="pull-right ex-text">@betChoice.HandicapValue</span>
                        </td>
                    }
                    else
                    {
                        <td class="ex-col">
                            <span class="pull-right ex-text">@betChoice.HandicapValue</span>
                        </td>
                    }
                }

                if (betTypeForecast.IsOneXTwoBetType)
                {
                    if (i == 1)
                    {
                        <td class="ex-col">
                            <span class="pull-left">@betTypeForecast.BetTypeName</span>
                            <span class="pull-right ex-text">@betChoice.HandicapValue</span>
                        </td>
                    }
                    else
                    {
                        <td class="ex-col">
                            <span class="pull-right ex-text">@betChoice.HandicapValue</span>
                        </td>
                    }
                }
            }

            @RenderBetChoiceForecast(betChoice, betTypeForecast.IsOneXTwoBetType)
        </tr>
    }

}

@helper RenderBetChoiceForecast(BetChoiceForecast betChoiceForecast, bool isOneXTwoBetType)
{

    <td class="ex-col text-right">@(Formater.DecFormat(betChoiceForecast.BetCount, 0))</td>
    <td class="ex-col text-right">@(Formater.DecFormat(betChoiceForecast.Turnover, 2))</td>

    foreach (var winloss in betChoiceForecast.WinLossValues)
    {
            <td class="ex-col @(isOneXTwoBetType ? "text-center" : "text-right")"
                @(isOneXTwoBetType ? "colspan=3" : string.Empty)>
                @FormatWinLossNumber(winloss)
            </td>
    }

}

@helper FormatWinLossNumber(decimal winloss)
{
    if (winloss > 0)
    {
        <span class="positive">@(Formater.DecFormat(winloss, 2))</span>
    }
    else
    {
        <span>@(Formater.DecFormat(winloss, 2))</span>
    }
}

@helper RenderMatchInfo(int matchRowSpan)
{
    <td rowspan="@matchRowSpan" class="col-time text-center">
        @if (Model.IsLive)
        {
            <span class="match-score">
                @Model.LiveHomeScore
                -
                @Model.LiveAwayScore
            </span> <br />
                <span class="offer-live">@Resources.Live</span>
        }
        else
        {
            if (Model.HasLive)
            {
                <span class="offer-live">@Resources.MatchOfferLive</span> <br />
            }
            <span class="match-time">@Model.KickOffTimeString</span>
        }
    </td>
    <td rowspan="@matchRowSpan" class="col-event">
        <span class="home-name">@Model.HomeName</span> <br />
        <span class="away-name">@Model.AwayName</span>
    </td>
}

@helper RenderForecastTotal(int matchRowSpan)
{
    <td rowspan="@matchRowSpan" class="text-center col-forecastTotal">
        @(Formater.DecFormat(Model.ForecastTotal, 2))
    </td>
}

@if (matchHasAnyBetType)
{
    <tbody id="match-@(Model.MatchId)" class="@(Model.IsLive ? "match-live" : string.Empty)">
        @*First row*@
        <tr class="even">

            @RenderMatchInfo(matchRowSpan)

            @RenderWinLossColumnName(Model.BetTypeForecasts.First().BetChoices.First(), false)

            @RenderForecastTotal(matchRowSpan)

        </tr>

        @*Render first row contains winloss name*@
        @RenderBetTypeForecast(Model.BetTypeForecasts.First(), true)

        @*Continue render winloss row and other bet type *@
        @for (int i = 1; i < totalBetTypes; i++)
        {
            var currentBetTypeForecast = Model.BetTypeForecasts.ElementAt(i);
            var isEven = i % 2 == 0;

            var firstBetChoice = currentBetTypeForecast.BetChoices.First();

            if (firstBetChoice.WinLossColumnNames.Any())
            {
                <tr class="@(isEven ? "even" : string.Empty)">
                    @RenderWinLossColumnName(firstBetChoice, currentBetTypeForecast.IsOverUnder)
                </tr>
            }

            @RenderBetTypeForecast(currentBetTypeForecast, isEven)

        }
    </tbody>
}
else
{
    <tbody id="no-info-body" data-match-id="match-@(Model.MatchId)">
        <tr class="no-info text-center">
            <td colspan="9">@Resources.NoData</td>
        </tr>
    </tbody>
}



