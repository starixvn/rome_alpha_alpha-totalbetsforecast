<appSettings>
  <add key="webpages:Enabled" value="false" />
  <add key="ClientValidationEnabled" value="true" />
  <add key="UnobtrusiveJavaScriptEnabled" value="true" />
  <add key="LocalTest" value="1" />
  <add key="VirtualDirectory" value="site-totalbetsforecast" />
  <add key="NewTBF:DisableHighlightChange" value="1"/>
  <add key="NewTBF:AllowSitesToViewForecast" value=""/>
  <add key="AssetAppPath" value="/assets" />
</appSettings>