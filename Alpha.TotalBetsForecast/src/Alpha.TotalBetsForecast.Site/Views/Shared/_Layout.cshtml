<!DOCTYPE html>
<html class="ifr-result">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@Resources.BetsAndForecast</title>

    @StaticResources.AssetStyles.RenderWithDarkMode("/bundles/site-totalbetsforecast/default")
    @RenderSection("ComponentStyles", false)
    @RenderSection("Styles", false)
    @Alpha.Web.Helpers.GoogleAnalyticHepler.GtagScript()
</head>
<body>
    @Alpha.Web.Helpers.GoogleAnalyticHepler.GtagNoScript()
    <div class="page-main">
        @RenderBody()
    </div>

    @Html.Hidden("RootURL", HttpContext.Current.Response.ApplyAppPathModifier("~/"))

    @StaticResources.AssetScripts.Render("/bundles/site-totalbetsforecast/default")
    @RenderSection("Scripts", false)

    @Html.Raw(Fanex.Logging.LogManager.RenderJavascriptLogger())
</body>
</html>


