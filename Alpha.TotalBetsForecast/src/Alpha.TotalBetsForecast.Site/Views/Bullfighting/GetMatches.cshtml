@model BullfightingViewModel
@{
    Layout = null;
}
<table class="tblRpt tblRpt-bordered col-sm-9">
    <thead>
        <tr class="RptHeader">
            <th class="text-center" rowspan="2">@Resources.Date</th>
            <th class="text-center  col-sm-5" rowspan="2">@Resources.Event</th>
            <th class="text-center" rowspan="2">@Resources.BetCount</th>
            <th class="text-center" rowspan="2">@Resources.Turnover</th>
            <th class="text-center" colspan="2">@Resources.ForecastWinLoss</th>
        </tr>
        <tr class="RptHeader">
            <th class="text-center">@Resources.Banker</th>
            <th class="text-center">@Resources.Player</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Arenas.Any())
        {
            foreach (var arena in Model.Arenas)
            {
                var oddRow = true;
                <tr class="cl-league">
                    <td colspan="6" class="bold">
                        @arena.Name
                        <span class="live-match">@arena.Status</span>
                    </td>
                </tr>
                foreach (var match in arena.Matchs)
                {
                    <tr class="@(oddRow ? string.Empty : "even")">
                        <td class="text-center">@match.EventDateToString</td>
                        <td class="text-left">
                            <span class="home-name">@match.HomeName</span>
                            <span>@Resources.Versus</span>
                            <span class="away-name">@match.AwayName</span>
                        </td>
                        <td class="text-right">
                            <a href="@Model.BuildBetListPath(@match.MatchId)">@match.BetCount</a>
                        </td>
                        <td class="text-right">@match.TurnoverToDislay</td>
                        @RenderWinLoss(match.Banker, match.BankerToDisplay)
                        @RenderWinLoss(match.Player, match.PlayerToDisplay)
                    </tr>
                    oddRow = !oddRow;
                }
            }
        }
        else
        {
            <tr class="no-info text-center">
                <td colspan="6">@Resources.NoData</td>
            </tr>
        }


    </tbody>
</table>

@helper RenderWinLoss(decimal winloss, string winlossToString)
{
if (winloss < 0)
{
        <td class="bold text-right">@winlossToString</td>
}
else
{
        <td class="positive text-right bold">@winlossToString</td>
}
}