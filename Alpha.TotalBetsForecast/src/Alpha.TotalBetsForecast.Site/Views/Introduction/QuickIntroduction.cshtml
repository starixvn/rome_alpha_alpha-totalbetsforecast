@{
    Layout = null;
}

<!-- Begin Modal -->
<!--<button type="button" class="btn btn-primary" data-toggle="modal" data-target=".bs-example-modal-sm">Small modal</button>-->

<div class="modal fade" id="beginModal" tabindex="-1" role="dialog" aria-labelledby="mySmallModalLabel">
    <div class="modal-dialog smallModal">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            </div>
            <div class="modal-body">
                <p><strong class="modal-title">Take a quick tour for Bets & Forecast</strong></p>
                <p>It's the fastest and most centralized Total Bets and Forecast ever</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-default" data-dismiss="modal" aria-label="Close" id="btnClose"><span aria-hidden="true">Not now</span></button>
                <button class="btn-submit js-let-go-btn" data-toggle="modal"><span>Let's go</span></button>
            </div>
        </div>
    </div>
</div>
<!-- Large modal -->
<div class="modal fade" id="quickIntroductionModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog  largeModal">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"><i class="icon-close"></i></button>
            </div>
            <div class="modal-body">
                <div id="carousel-main" class="carousel slide carousel-fade" data-ride="carousel">
                    <!-- Wrapper for slides -->
                    <div class="carousel-inner">
                        <div class="item active">
                            <h4>It starts with the new and intuitive menu</h4>
                            <div class="slider"><img src="~/assets/styles/images/slide2.png" /></div>
                        </div>
                        <div class="item">
                            <h4>It starts with the new and intuitive menu</h4>
                            <div class="slider"><img src="~/assets/styles/images/slide3.png" /></div>
                        </div>
                        <div class="item">
                            <h4>The meaningful LIVE Forecast Win Loss of Handicap</h4>
                            <ul class="info-text">
                                <li>Current Forecast Win Loss always starts from <strong>Score 0</strong></li>
                                <li>New Forecast Win Loss starts from <strong>Current Score</strong></li>
                            </ul>
                            <div class="slider">
                                <img src="~/assets/styles/images/slide4.png" />
                            </div>

                            <div class="slider-text">
                                * Each bet type has its own Forecast Win Loss display, please refer to 
                                <a class="js-help" href="javascript:void(0);" id="btnShowUserguide">
                                    <u class="c-blue">this guideline</u><i class="icon-information-outline c-blue"></i>
                                </a> for more details
                            </div>
                        </div>
                    </div>
                    <div class="carousel-caption">
                    </div>

                    <!-- Controls -->
                    <div class="buttons-control">
                        <a class="left carousel-control" href="#carousel-main" role="button" data-slide="prev">
                            <span class="glyphicon glyphicon-chevron-left"></span>
                            <span class="text prev"><i class="icon-caret-left"></i></span>
                        </a>
                        <a class="right carousel-control" href="#carousel-main" role="button" data-slide="next">
                            <span class="text next"><i class="icon-caret-right"></i></span>
                            <span class="glyphicon glyphicon-chevron-right"></span>
                        </a>
                    </div>
                    <!-- /.carousel -->
                </div>
            </div>
        </div>
    </div>
</div>